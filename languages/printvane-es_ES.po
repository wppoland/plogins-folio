#. Plugin Name of the plugin
#: printvane.php
msgid "Printvane - Product Sheets, Catalogs and Price Lists for WooCommerce"
msgstr ""
"Printvane - Fichas de producto, catálogos y listas de precios para "
"WooCommerce"

#. Plugin URI of the plugin
#: printvane.php
msgid "https://plogins.com/printvane/"
msgstr "https://plogins.com/printvane/"

#. Description of the plugin
#: printvane.php
msgid ""
"Print a product sheet, a whole category catalog or a price list straight "
"from your shop, and save it as PDF from your browser."
msgstr ""
"Imprime una ficha de producto, el catálogo de una categoría completa o una "
"lista de precios directamente desde tu tienda, y guárdalo como PDF desde el "
"navegador."

#. Author of the plugin
#: printvane.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: printvane.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: printvane.php:48
msgid "Printvane requires WooCommerce to be active."
msgstr "Printvane necesita que WooCommerce esté activo."

#: src/Admin/ProductActions.php:37
msgid "Print"
msgstr "Imprimir"

#: src/Admin/Settings.php:44
msgid "Printvane Settings"
msgstr "Ajustes de Printvane"

#: src/Admin/Settings.php:45 src/Admin/Settings.php:119
msgid "Printvane"
msgstr "Printvane"

#: src/Admin/Settings.php:121
msgid ""
"Print a product sheet, a category catalog or a price list. Use your "
"browser's print dialog to save any of them as a PDF."
msgstr ""
"Imprime una ficha de producto, un catálogo de categoría o una lista de "
"precios. Usa el diálogo de impresión del navegador para guardar cualquiera "
"de ellos como PDF."

#: src/Admin/Settings.php:127
msgid "Preview the whole-shop catalog"
msgstr "Vista previa del catálogo de toda la tienda"

#: src/Admin/Settings.php:131
msgid "Preview the price list"
msgstr "Vista previa de la lista de precios"

#: src/Admin/Settings.php:138
msgid "Where the links appear"
msgstr "Dónde aparecen los enlaces"

#: src/Admin/Settings.php:141
msgid "On the product page"
msgstr "En la página del producto"

#: src/Admin/Settings.php:142
msgid "On shop and category pages"
msgstr "En las páginas de la tienda y de categorías"

#: src/Admin/Settings.php:146
msgid "What each document shows"
msgstr "Qué muestra cada documento"

#: src/Admin/Settings.php:149 src/Service/Texts.php:36
msgid "Product sheet"
msgstr "Ficha de producto"

#: src/Admin/Settings.php:150 src/Service/Texts.php:37
msgid "Catalog"
msgstr "Catálogo"

#: src/Admin/Settings.php:151 src/Service/Texts.php:38
msgid "Price list"
msgstr "Lista de precios"

#: src/Admin/Settings.php:155
msgid "Catalog columns"
msgstr "Columnas del catálogo"

#: src/Admin/Settings.php:161
msgid "Columns are applied when printing, not on screen."
msgstr "Las columnas se aplican al imprimir, no en pantalla."

#: src/Admin/Settings.php:166
msgid "Header and footer"
msgstr "Encabezado y pie de página"

#: src/Admin/Settings.php:169
msgid "Show a logo"
msgstr "Mostrar un logotipo"

#: src/Admin/Settings.php:173
msgid "Logo attachment ID"
msgstr "ID del adjunto del logotipo"

#: src/Admin/Settings.php:179
msgid ""
"The media library ID of the image to print in the header. Leave at 0 for "
"none."
msgstr ""
"El ID en la biblioteca de medios de la imagen que se imprime en el "
"encabezado. Déjalo en 0 para no imprimir ninguna."

#: src/Admin/Settings.php:183
msgid "Show the shop name"
msgstr "Mostrar el nombre de la tienda"

#: src/Admin/Settings.php:184
msgid "Show the date the document was printed"
msgstr "Mostrar la fecha en que se imprimió el documento"

#: src/Admin/Settings.php:185
msgid "Show how many products the document holds"
msgstr "Mostrar cuántos productos contiene el documento"

#: src/Admin/Settings.php:189
msgid "Footer note"
msgstr "Nota al pie"

#: src/Admin/Settings.php:196
msgid ""
"Printed at the end of every document. Prices valid until, terms, contact "
"details."
msgstr ""
"Se imprime al final de cada documento. Validez de los precios, condiciones, "
"datos de contacto."

#: src/Admin/Settings.php:201
msgid "Wording"
msgstr "Textos"

#: src/Admin/Settings.php:203
msgid ""
"Leave a field empty to use the translated default for your site language."
msgstr ""
"Deja un campo vacío para usar el texto predeterminado traducido al idioma de"
" tu sitio."

#: src/Admin/Settings.php:229
msgid "Enabled"
msgstr "Activado"

